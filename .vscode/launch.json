{
    "version": "0.2.0",

    "configurations": [
        {
            "name": "Debug",
            "type": "cppdbg",
            "request": "launch",

            "program": "${workspaceFolder}\\build\\program.exe",

            "args": [],

            "stopAtEntry": false,

            "cwd": "${workspaceFolder}",

            "environment": [],

            "externalConsole": true,

            "MIMode": "gdb",

            "miDebuggerPath": "C:\\MinGW\\bin\\gdb.exe",

            "preLaunchTask": "Build",

            "setupCommands": [
                {
                    "description": "Enable pretty-printing for GDB",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}